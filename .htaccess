DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# Temporary GoDaddy public surface: homepage + Ghana Gold pages only.
RewriteRule ^ghana$ /ghana/ [R=301,L]
RewriteRule ^concessions$ /concessions/ [R=301,L]

# Keep operational/admin surfaces private.
RewriteRule ^(dashboard|aurora_dashboard\.html|aurora_dashboard\.htm|data-room-admin|sales|api/sales|api/data-room|scan|scans|demo|validation|avan|ariss|twin|auth)(/.*)?$ - [F,L]

# Preserve retired public routes as gone instead of relaunching stale pages.
RewriteRule ^(platform|aoi-library|sample-reports|data-room/hot-list|data-room/checkout|data-room/nda/sign|data-room/login|data-room)(/.*)?$ - [G,L]
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<FilesMatch "(^\.env|\.pem$|\.ppk$|\.key$|secrets|users\.json)">
Require all denied
</FilesMatch>
